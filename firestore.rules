rules_version = '2';

// BonManzE v1 Firestore security rules — written against
// BonManzE_Firestore_Schema.md (Claude Project doc). "demo-bonmanze" (see
// .firebaserc) means this only ever applies to the local emulator right
// now, not a real Firebase project.
//
// Two kinds of signed-in user, told apart by which top-level doc exists for
// their UID: customers/{uid} or staff/{uid}. Staff actions are gated by a
// configurable roles/{roleId} permission map (see the Roles & Permissions
// Settings tab) rather than a fixed role enum — isStaffAllowed() below is
// the one place that logic lives, so every collection's rules stay short.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Shared helpers ----

    function isSignedIn() {
      return request.auth != null;
    }

    function isCustomer(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function isActiveStaff() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && staffDoc().data.active == true;
    }

    // Resolves the signed-in staff member's role live (never trust a copy —
    // see the schema doc's note on why roleId stays a pointer, not a
    // denormalized permission snapshot) and checks a granular permission.
    function isStaffAllowed(groupName, permissionType) {
      return isActiveStaff()
        && exists(/databases/$(database)/documents/roles/$(staffDoc().data.roleId))
        && 'permissions' in get(/databases/$(database)/documents/roles/$(staffDoc().data.roleId)).data
        && groupName in get(/databases/$(database)/documents/roles/$(staffDoc().data.roleId)).data.permissions
        && permissionType in get(/databases/$(database)/documents/roles/$(staffDoc().data.roleId)).data.permissions[groupName]
        && get(/databases/$(database)/documents/roles/$(staffDoc().data.roleId)).data.permissions[groupName][permissionType] == true;
    }

    // ---- customers/{uid} ----
    // A customer reads/writes only their own doc. Financial/loyalty fields
    // (points, storeCredit, tier, ltv) are NOT directly writable by anyone
    // here — those only ever change via a Cloud Function using the Admin
    // SDK, which bypasses these rules entirely. Staff with customerDirectory edit
    // can read/update the directory (e.g. fixing a typo'd address), but the
    // same financial-field lockout applies to them too.
    match /customers/{uid} {
      allow read: if isCustomer(uid) || isStaffAllowed('customerDirectory', 'view') || isStaffAllowed('pendingRegistrations', 'view');
      allow create: if isCustomer(uid)
        && !('points' in request.resource.data)
        && !('storeCredit' in request.resource.data)
        && !('tier' in request.resource.data)
        && !('ltv' in request.resource.data)
        && !('group' in request.resource.data)
        && !('entityId' in request.resource.data)
        && !('registrationStatus' in request.resource.data)
        && !('rejectionReason' in request.resource.data);
      allow update: if (isCustomer(uid)
          && request.resource.data.points == resource.data.points
          && request.resource.data.storeCredit == resource.data.storeCredit
          && request.resource.data.tier == resource.data.tier
          && request.resource.data.ltv == resource.data.ltv
          && request.resource.data.group == resource.data.group
          && request.resource.data.get('entityId', null) == resource.data.get('entityId', null)
          // Customer resubmit transition: Rejected -> Pending
          && (request.resource.data.get('registrationStatus', null) == resource.data.get('registrationStatus', null)
              || (resource.data.get('registrationStatus', null) == 'Rejected'
                  && request.resource.data.registrationStatus == 'Pending'))
          && (request.resource.data.get('rejectionReason', null) == resource.data.get('rejectionReason', null)
              || (resource.data.get('registrationStatus', null) == 'Rejected'
                  && request.resource.data.registrationStatus == 'Pending'
                  && request.resource.data.get('rejectionReason', null) == null)))
        || (isStaffAllowed('customerDirectory', 'edit')
          && request.resource.data.points == resource.data.points
          && request.resource.data.storeCredit == resource.data.storeCredit
          && request.resource.data.ltv == resource.data.ltv
          && request.resource.data.tier == resource.data.tier
          && request.resource.data.get('entityId', null) == resource.data.get('entityId', null)
          && request.resource.data.get('registrationStatus', null) == resource.data.get('registrationStatus', null)
          && request.resource.data.get('rejectionReason', null) == resource.data.get('rejectionReason', null))
        || (isStaffAllowed('pendingRegistrations', 'edit')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['entityId', 'registrationStatus', 'rejectionReason', 'updatedAt']));
      allow delete: if false; // no hard-delete from the client, ever
    }

    // ---- usernames/{username} ----
    // Must be readable while signed out (the login screen resolves a typed
    // username to an email before auth happens) — see the schema doc's
    // trade-off note. Only the account it points at may claim it, and only
    // once; no renaming in v1.
    match /usernames/{username} {
      allow get: if true;
      allow list: if false; // no enumerating the collection, only exact-id lookups
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.uid;
      allow update, delete: if false;
    }

    // ---- staff/{uid} ----
    // Only rolesAndStaff edit can create/edit staff records or reassign roles —
    // this is the one place a privilege-escalation path would open up if
    // it were folded into a broader permission instead of its own key.
    match /staff/{uid} {
      allow read: if isActiveStaff();
      allow create: if false; // strictly created via createStaffMember Cloud Function
      allow update: if isStaffAllowed('rolesAndStaff', 'edit')
        && (request.auth.uid != uid
            || (request.resource.data.active == true
                && request.resource.data.roleId == resource.data.roleId));
      allow delete: if false;
    }

    // ---- roles/{roleId} ----
    match /roles/{roleId} {
      allow read: if isActiveStaff();
      allow write: if isStaffAllowed('rolesAndStaff', 'edit');
    }

    // ---- auditLog/{id} ----
    // Append-only from the app's point of view: written by Cloud Functions
    // (Admin SDK, bypasses these rules) when they perform the action being
    // logged, plus direct writes from staff with manageConfig for config
    // changes made straight from the client. Never editable or deletable
    // once written — that's the point of an audit log.
    match /auditLog/{id} {
      allow read: if isStaffAllowed('rolesAndStaff', 'view');
      allow create: if isActiveStaff()
        && request.resource.data.staffUid == request.auth.uid
        && request.resource.data.timestamp == request.time
        && request.resource.data.type in ['ConfigChange', 'RoleChange', 'RegistrationDecision', 'EntityReassignment', 'PaymentConfirmed', 'DeliveryConfirmed']
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0;
      allow update, delete: if false;
    }

    // ---- Meal Library / Menu Planner ----
    match /mains/{mainId} {
      allow read: if true; // public menu content
      allow write: if isStaffAllowed('mealLibrary', 'edit');
    }
    match /menuWeeks/{weekStart} {
      allow read: if true;
      allow write: if isStaffAllowed('menuPlanner', 'edit');
    }
    match /menuDefaults/{docId} {
      allow read: if true;
      allow write: if isStaffAllowed('menuPlanner', 'edit');
    }
    match /mealBases/{docId} {
      allow read: if true;
      allow write: if isStaffAllowed('mealLibrary', 'edit');
    }
    match /mealDhals/{docId} {
      allow read: if true;
      allow write: if isStaffAllowed('mealLibrary', 'edit');
    }
    match /mealSalads/{docId} {
      allow read: if true;
      allow write: if isStaffAllowed('mealLibrary', 'edit');
    }
    match /mealBeverages/{docId} {
      allow read: if true;
      allow write: if isStaffAllowed('mealLibrary', 'edit');
    }
    match /mealDesserts/{docId} {
      allow read: if true;
      allow write: if isStaffAllowed('mealLibrary', 'edit');
    }
    match /iconLibrary/{docId} {
      allow read: if isActiveStaff(); // admin-only picker content, not customer-facing
      allow write: if isStaffAllowed('iconLibrary', 'edit');
    }

    // ---- Config ----
    match /config/{docId} {
      allow read: if true; // customers need cutoff/delivery-window/branding copy
      allow write: if isStaffAllowed('generalConfig', 'edit');
    }
    match /loyaltyTiers/{docId} {
      allow read: if true; // Customer App shows tier perks
      allow write: if isStaffAllowed('loyaltyTiers', 'edit');
    }
    match /customerGroups/{docId} {
      allow read: if isActiveStaff(); // internal segmentation, not customer-facing
      allow write: if isStaffAllowed('customerGroups', 'edit');
    }
    match /entities/{entityId} {
      allow read: if isActiveStaff();
      allow write: if isStaffAllowed('tradingEntities', 'edit');
    }

    // ---- orders/{orderId} and its items subcollection (manageOrders) ----
    // A customer may read their own orders but never create or edit one
    // directly — checkout goes through the confirmCheckout Cloud Function
    // (Admin SDK, bypasses these rules), which is the only thing allowed to
    // decide what an order's/item's total/price actually is. Direct client
    // create used to be allowed here with no field restriction at all
    // (a client could submit any total/price it wanted) — closed 2026-08-13
    // once confirmCheckout existed to do that job properly instead.
    match /orders/{orderId} {
      allow read: if isCustomer(resource.data.customerId)
        || isStaffAllowed('ordersByDish', 'view')
        || isStaffAllowed('deliveryList', 'view')
        || isStaffAllowed('payments', 'view');
      allow create: if false; // Cloud Function only — see confirmCheckout
      allow update, delete: if false;
    }

    // items lives as a subcollection of orders/{orderId}, but is matched
    // here at the TOP LEVEL with {path=**} rather than nested inside the
    // orders/{orderId} match above.
    match /{path=**}/items/{itemId} {
      allow read: if isCustomer(resource.data.customerId)
        || isStaffAllowed('ordersByDish', 'view')
        || isStaffAllowed('deliveryList', 'view')
        || isStaffAllowed('payments', 'view');
      allow create: if false; // Cloud Function only — see confirmCheckout
      allow update: if (
          // 1. Staff update
          (
            (
              // Payment edit
              (request.resource.data.paymentStatus != resource.data.paymentStatus
               || request.resource.data.get('paymentMethodName', null) != resource.data.get('paymentMethodName', null)
               || request.resource.data.get('paymentReference', null) != resource.data.get('paymentReference', null))
              && isStaffAllowed('payments', 'edit')
              && request.resource.data.status == resource.data.status
            ) || (
              // Status edit: Cooking/Dispatch/Deliver
              request.resource.data.status != resource.data.status
              && (
                (request.resource.data.status == 'Preparing' || request.resource.data.status == 'Active')
                  ? isStaffAllowed('ordersByDish', 'edit')
                  : isStaffAllowed('deliveryList', 'edit')
              )
              && request.resource.data.paymentStatus == resource.data.paymentStatus
              && request.resource.data.get('paymentMethodName', null) == resource.data.get('paymentMethodName', null)
              && request.resource.data.get('paymentReference', null) == resource.data.get('paymentReference', null)
            )
          )
          && request.resource.data.price == resource.data.price
          && request.resource.data.qty == resource.data.qty
          && request.resource.data.name == resource.data.name
          && request.resource.data.customerId == resource.data.customerId
        ) || (
          // 2. Customer update (pay claim)
          isCustomer(resource.data.customerId)
          && request.resource.data.paymentStatus == resource.data.paymentStatus
          && request.resource.data.price == resource.data.price
          && request.resource.data.qty == resource.data.qty
          && request.resource.data.name == resource.data.name
          && request.resource.data.status == resource.data.status
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.deliveryDate == resource.data.deliveryDate
          && request.resource.data.serviceSlot == resource.data.serviceSlot
          && request.resource.data.get('tierAtOrder', null) == resource.data.get('tierAtOrder', null)
          && request.resource.data.get('isReconciled', null) == resource.data.get('isReconciled', null)
          && request.resource.data.get('notes', null) == resource.data.get('notes', null)
          && (resource.data.paymentStatus != 'Paid'
              || (request.resource.data.get('paymentMethodName', null) == resource.data.get('paymentMethodName', null)
                  && request.resource.data.get('paymentReference', null) == resource.data.get('paymentReference', null)))
        );
      allow delete: if false;
    }

    // Everything else stays locked down by default — same starting
    // posture as before any collection existed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
