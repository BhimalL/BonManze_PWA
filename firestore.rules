rules_version = '2';

// BonManzE v1 Firestore security rules — written against
// BonManzE_Firestore_Schema.md (Claude Project doc). "demo-bonmanze" (see
// .firebaserc) means this only ever applies to the local emulator right
// now, not a real Firebase project.
//
// Two kinds of signed-in user, told apart by which top-level doc exists for
// their UID: customers/{uid} or staff/{uid}. Staff actions are gated by a
// configurable roles/{roleId} permission map (see the Roles & Permissions
// Settings tab) rather than a fixed role enum — isStaffAllowed() below is
// the one place that logic lives, so every collection's rules stay short.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Shared helpers ----

    function isSignedIn() {
      return request.auth != null;
    }

    function isCustomer(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function isActiveStaff() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && staffDoc().data.active == true;
    }

    // Resolves the signed-in staff member's role live (never trust a copy —
    // see the schema doc's note on why roleId stays a pointer, not a
    // denormalized permission snapshot) and checks a granular permission.
    // 2026-09: rewritten to fetch roles/{roleId} once via `let` instead of
    // four separate get() calls per invocation — with the items/{itemId}
    // update rule below now calling isStaffAllowed() several times in one
    // write, the old 4x-get version was a major contributor to that rule
    // tripping Firestore's "maximum of 1000 expressions" per-write cap.
    function isStaffAllowed(groupName, permissionType) {
      return isActiveStaff() && staffAllowedForRole(staffDoc().data.roleId, groupName, permissionType);
    }

    function staffAllowedForRole(roleId, groupName, permissionType) {
      return exists(/databases/$(database)/documents/roles/$(roleId))
        && staffHasPermission(roleId, groupName, permissionType);
    }

    function staffHasPermission(roleId, groupName, permissionType) {
      let role = get(/databases/$(database)/documents/roles/$(roleId)).data;
      return ('permissions' in role)
        && (groupName in role.permissions)
        && (permissionType in role.permissions[groupName])
        && (role.permissions[groupName][permissionType] == true);
    }

    // Partner accounts (BonManzE_PartnerAccounts_Scope.md): unlike the
    // Entity-Restricted Views filter, this IS a security boundary — Partner
    // staff are external/less-trusted and must be hard-locked out of any
    // entity they aren't assigned to, enforced here, not just filtered
    // client-side in Operations.tsx.
    function isPartnerStaff() {
      return isActiveStaff() && staffDoc().data.get('isPartner', false) == true;
    }

    // true for: any non-Partner request (no-op — everyone else is
    // unaffected), OR a Partner request whose entityId is in their
    // assignedEntityIds. false for a Partner request against any other
    // entity, or against a document with no entityId at all.
    function isPartnerEntityAllowed(entityId) {
      return !isPartnerStaff() || (entityId != null && entityId in staffDoc().data.get('assignedEntityIds', []));
    }

    // Delivery Staff Payments (BonManzE_DeliveryPayments_Scope.md): a
    // driver is, like a Partner, less-trusted external/field staff — this
    // IS a real security boundary (not just client-side filtering), same
    // reasoning as isPartnerEntityAllowed above, just keyed on a single
    // assignedDriverId instead of a list of entity ids.
    function isDriverStaff() {
      return isActiveStaff() && staffDoc().data.get('isDriver', false) == true;
    }

    // true for: any non-driver request (no-op), OR a driver request whose
    // item is assigned to exactly them. false for a driver request
    // against any other driver's item, or an unassigned item.
    function isDriverItemAllowed(assignedDriverId) {
      return !isDriverStaff() || (assignedDriverId != null && assignedDriverId == request.auth.uid);
    }

    // ---- customers/{uid} ----
    // A customer reads/writes only their own doc. Financial/loyalty fields
    // (points, storeCredit, tier, ltv) are NOT directly writable by anyone
    // here — those only ever change via a Cloud Function using the Admin
    // SDK, which bypasses these rules entirely. Staff with customerDirectory edit
    // can read/update the directory (e.g. fixing a typo'd address), but the
    // same financial-field lockout applies to them too.
    match /customers/{uid} {
      allow read: if isCustomer(uid) || isStaffAllowed('customerDirectory', 'view') || isStaffAllowed('pendingRegistrations', 'view');
      allow create: if isCustomer(uid)
        && !('points' in request.resource.data)
        && !('storeCredit' in request.resource.data)
        && !('tier' in request.resource.data)
        && !('ltv' in request.resource.data)
        && !('group' in request.resource.data)
        && !('entityId' in request.resource.data)
        && !('registrationStatus' in request.resource.data)
        && !('rejectionReason' in request.resource.data);
      allow update: if (isCustomer(uid)
          && request.resource.data.points == resource.data.points
          && request.resource.data.storeCredit == resource.data.storeCredit
          && request.resource.data.tier == resource.data.tier
          && request.resource.data.ltv == resource.data.ltv
          && request.resource.data.group == resource.data.group
          && request.resource.data.get('entityId', null) == resource.data.get('entityId', null)
          // Customer resubmit transition: Rejected -> Pending
          && (request.resource.data.get('registrationStatus', null) == resource.data.get('registrationStatus', null)
              || (resource.data.get('registrationStatus', null) == 'Rejected'
                  && request.resource.data.registrationStatus == 'Pending'))
          && (request.resource.data.get('rejectionReason', null) == resource.data.get('rejectionReason', null)
              || (resource.data.get('registrationStatus', null) == 'Rejected'
                  && request.resource.data.registrationStatus == 'Pending'
                  && request.resource.data.get('rejectionReason', null) == null)))
        || (isStaffAllowed('customerDirectory', 'edit')
          && request.resource.data.points == resource.data.points
          && request.resource.data.storeCredit == resource.data.storeCredit
          && request.resource.data.ltv == resource.data.ltv
          && request.resource.data.tier == resource.data.tier
          && request.resource.data.get('entityId', null) == resource.data.get('entityId', null)
          && request.resource.data.get('registrationStatus', null) == resource.data.get('registrationStatus', null)
          && request.resource.data.get('rejectionReason', null) == resource.data.get('rejectionReason', null))
        || (isStaffAllowed('pendingRegistrations', 'edit')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['entityId', 'registrationStatus', 'rejectionReason', 'updatedAt']));
      allow delete: if false; // no hard-delete from the client, ever
    }

    // ---- usernames/{username} ----
    // Must be readable while signed out (the login screen resolves a typed
    // username to an email before auth happens) — see the schema doc's
    // trade-off note. Only the account it points at may claim it, and only
    // once; no renaming in v1.
    match /usernames/{username} {
      allow get: if true;
      allow list: if false; // no enumerating the collection, only exact-id lookups
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.uid;
      allow update, delete: if false;
    }

    // ---- staff/{uid} ----
    // Only rolesAndStaff edit can create/edit staff records or reassign roles —
    // this is the one place a privilege-escalation path would open up if
    // it were folded into a broader permission instead of its own key.
    match /staff/{uid} {
      allow read: if isActiveStaff();
      allow create: if false; // strictly created via createStaffMember Cloud Function
      allow update: if isStaffAllowed('rolesAndStaff', 'edit')
        && (request.auth.uid != uid
            || (request.resource.data.active == true
                && request.resource.data.roleId == resource.data.roleId));
      allow delete: if false;
    }

    // ---- roles/{roleId} ----
    match /roles/{roleId} {
      allow read: if isActiveStaff();
      allow write: if isStaffAllowed('rolesAndStaff', 'edit');
    }

    // ---- auditLog/{id} ----
    // Append-only from the app's point of view: written by Cloud Functions
    // (Admin SDK, bypasses these rules) when they perform the action being
    // logged, plus direct writes from staff with manageConfig for config
    // changes made straight from the client. Never editable or deletable
    // once written — that's the point of an audit log.
    match /auditLog/{id} {
      allow read: if isStaffAllowed('rolesAndStaff', 'view');
      allow create: if isActiveStaff()
        && request.resource.data.staffUid == request.auth.uid
        && request.resource.data.timestamp == request.time
        && request.resource.data.type in ['ConfigChange', 'RoleChange', 'RegistrationDecision', 'EntityReassignment', 'PaymentConfirmed', 'DeliveryConfirmed']
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0;
      allow update, delete: if false;
    }

    // ---- Meal Library / Menu Planner ----
    match /mains/{mainId} {
      allow read: if true; // public menu content
      allow write: if isStaffAllowed('mealLibrary', 'edit');
    }
    match /menuWeeks/{weekStart} {
      allow read: if true;
      allow write: if isStaffAllowed('menuPlanner', 'edit');
    }
    match /menuDefaults/{docId} {
      allow read: if true;
      allow write: if isStaffAllowed('menuPlanner', 'edit');
    }
    match /mealBases/{docId} {
      allow read: if true;
      allow write: if isStaffAllowed('mealLibrary', 'edit');
    }
    match /mealDhals/{docId} {
      allow read: if true;
      allow write: if isStaffAllowed('mealLibrary', 'edit');
    }
    match /mealSalads/{docId} {
      allow read: if true;
      allow write: if isStaffAllowed('mealLibrary', 'edit');
    }
    match /mealBeverages/{docId} {
      allow read: if true;
      allow write: if isStaffAllowed('mealLibrary', 'edit');
    }
    match /mealDesserts/{docId} {
      allow read: if true;
      allow write: if isStaffAllowed('mealLibrary', 'edit');
    }
    match /iconLibrary/{docId} {
      allow read: if isActiveStaff(); // admin-only picker content, not customer-facing
      allow write: if isStaffAllowed('iconLibrary', 'edit');
    }

    // ---- Config ----
    match /config/{docId} {
      allow read: if true; // customers need cutoff/delivery-window/branding copy
      allow write: if isStaffAllowed('generalConfig', 'edit');
    }
    match /loyaltyTiers/{docId} {
      allow read: if true; // Customer App shows tier perks
      allow write: if isStaffAllowed('loyaltyTiers', 'edit');
    }
    match /customerGroups/{docId} {
      allow read: if isActiveStaff(); // internal segmentation, not customer-facing
      allow write: if isStaffAllowed('customerGroups', 'edit');
    }
    match /entities/{entityId} {
      allow read: if isActiveStaff();
      allow write: if isStaffAllowed('tradingEntities', 'edit');
    }
    match /paymentMethods/{docId} {
      allow read: if true; // customers need this to render the Pay sheet, same reasoning as config/loyaltyTiers
      allow write: if isStaffAllowed('paymentMethods', 'edit');
    }

    // ---- orders/{orderId} and its items subcollection (manageOrders) ----
    // A customer may read their own orders but never create or edit one
    // directly — checkout goes through the confirmCheckout Cloud Function
    // (Admin SDK, bypasses these rules), which is the only thing allowed to
    // decide what an order's/item's total/price actually is. Direct client
    // create used to be allowed here with no field restriction at all
    // (a client could submit any total/price it wanted) — closed 2026-08-13
    // once confirmCheckout existed to do that job properly instead.
    // Deliberately NOT driver-scoped here (unlike the items rule below):
    // assignedDriverId lives per-item, not on the order envelope itself —
    // an order can hold drops assigned to different drivers or none at
    // all. A driver-flagged account can therefore still read the (coarse)
    // order envelope for orders outside their own route, same as any
    // other deliveryList/payments-view staff today; the actual sensitive
    // data and the ability to act on it are both item-level, and item
    // reads/writes are the real driver-scoping boundary below.
    match /orders/{orderId} {
      allow read: if isPartnerEntityAllowed(resource.data.get('entityId', null))
        && (isCustomer(resource.data.customerId)
          || isStaffAllowed('ordersByDish', 'view')
          || isStaffAllowed('deliveryList', 'view')
          || isStaffAllowed('payments', 'view'));
      allow create: if false; // Cloud Function only — see confirmCheckout
      allow update, delete: if false;
    }

    // items lives as a subcollection of orders/{orderId}, but is matched
    // here at the TOP LEVEL with {path=**} rather than nested inside the
    // orders/{orderId} match above.
    match /{path=**}/items/{itemId} {
      allow read: if isPartnerEntityAllowed(resource.data.get('entityId', null))
        && isDriverItemAllowed(resource.data.get('assignedDriverId', null))
        && (isCustomer(resource.data.customerId)
          || isStaffAllowed('ordersByDish', 'view')
          || isStaffAllowed('deliveryList', 'view')
          || isStaffAllowed('payments', 'view'));
      allow create: if false; // Cloud Function only — see confirmCheckout

      // 2026-09 fix: this rule started throwing PERMISSION_DENIED
      // ("maximum of 1000 expressions to evaluate has been reached") once
      // clause 4 (Driver deliver + claim) was added on top of the existing
      // three — isStaffAllowed('deliveryList','edit') and
      // isCustomer(resource.data.customerId) were each being evaluated
      // twice per write (once in clause 1 or 3, again in clause 2 or 4),
      // and isStaffAllowed itself re-fetched roles/{roleId} four times per
      // call (see the 2026-09 note on isStaffAllowed above). Both are now
      // fixed: the role doc is fetched once per isStaffAllowed call, and
      // the two genuinely-repeated checks below are computed once via
      // `let` and reused, instead of being re-evaluated inline.
      function canUpdateItem() {
        let isCust = isCustomer(resource.data.customerId);
        let canEditDeliveryList = isStaffAllowed('deliveryList', 'edit');
        return (
          // 1. Staff update
          (
            (
              // Payment edit — an amount-aware Mark Paid/Reconcile confirm
              // (a Partial claim that doesn't cover the full price also
              // clears paymentMethodName/paymentReference without changing
              // paymentStatus) or a Write Off need these two fields
              // recognized here too, or the write falls through every
              // clause below and gets rejected.
              (request.resource.data.paymentStatus != resource.data.paymentStatus
               || request.resource.data.get('paymentMethodName', null) != resource.data.get('paymentMethodName', null)
               || request.resource.data.get('paymentReference', null) != resource.data.get('paymentReference', null)
               || request.resource.data.get('paymentPaidAmount', null) != resource.data.get('paymentPaidAmount', null)
               || request.resource.data.get('paymentWrittenOff', null) != resource.data.get('paymentWrittenOff', null))
              && isStaffAllowed('payments', 'edit')
              && request.resource.data.status == resource.data.status
            ) || (
              // Status edit: Cooking/Dispatch/Deliver
              request.resource.data.status != resource.data.status
              && (
                (request.resource.data.status == 'Preparing' || request.resource.data.status == 'Ready' || request.resource.data.status == 'Active')
                  ? (isStaffAllowed('ordersByDish', 'edit') || canEditDeliveryList)
                  : canEditDeliveryList
              )
              && request.resource.data.paymentStatus == resource.data.paymentStatus
              && request.resource.data.get('paymentMethodName', null) == resource.data.get('paymentMethodName', null)
              && request.resource.data.get('paymentReference', null) == resource.data.get('paymentReference', null)
            )
          )
          && request.resource.data.price == resource.data.price
          && request.resource.data.qty == resource.data.qty
          && request.resource.data.name == resource.data.name
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.get('entityId', null) == resource.data.get('entityId', null)
        ) || (
          // 2. Customer update (pay claim)
          isCust
          && request.resource.data.paymentStatus == resource.data.paymentStatus
          && request.resource.data.price == resource.data.price
          && request.resource.data.qty == resource.data.qty
          && request.resource.data.name == resource.data.name
          && request.resource.data.status == resource.data.status
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.get('entityId', null) == resource.data.get('entityId', null)
          && request.resource.data.deliveryDate == resource.data.deliveryDate
          && request.resource.data.serviceSlot == resource.data.serviceSlot
          && request.resource.data.get('tierAtOrder', null) == resource.data.get('tierAtOrder', null)
          && request.resource.data.get('isReconciled', null) == resource.data.get('isReconciled', null)
          && request.resource.data.get('notes', null) == resource.data.get('notes', null)
          // 2026-09: paymentPaidAmount/paymentWrittenOff are Resolve-only
          // fields (Operations Payments tab, payments.edit staff only) —
          // pin them equal here so a customer's own pay-claim write can
          // never touch them, same reasoning as every other pinned field
          // in this clause.
          && request.resource.data.get('paymentPaidAmount', null) == resource.data.get('paymentPaidAmount', null)
          && request.resource.data.get('paymentWrittenOff', null) == resource.data.get('paymentWrittenOff', null)
          && (resource.data.paymentStatus != 'Paid'
              || (request.resource.data.get('paymentMethodName', null) == resource.data.get('paymentMethodName', null)
                  && request.resource.data.get('paymentReference', null) == resource.data.get('paymentReference', null)))
        ) || (
          // 3. Reprint-count bump (Operations Payments/paid-history view, or
          // the customer's own receipt re-view). Only invoiceReprintCount
          // may change; invoiceNumber/invoiceIssuedAt themselves are set
          // only by issueInvoiceOnPayment's Admin SDK write, never by a
          // client, so both are pinned equal here too.
          (isStaffAllowed('payments', 'view') || isCust)
          && request.resource.data.get('invoiceReprintCount', null) != resource.data.get('invoiceReprintCount', null)
          && request.resource.data.paymentStatus == resource.data.paymentStatus
          && request.resource.data.get('paymentMethodName', null) == resource.data.get('paymentMethodName', null)
          && request.resource.data.get('paymentReference', null) == resource.data.get('paymentReference', null)
          && request.resource.data.status == resource.data.status
          && request.resource.data.price == resource.data.price
          && request.resource.data.qty == resource.data.qty
          && request.resource.data.name == resource.data.name
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.get('entityId', null) == resource.data.get('entityId', null)
          && request.resource.data.get('invoiceNumber', null) == resource.data.get('invoiceNumber', null)
          && request.resource.data.get('invoiceIssuedAt', null) == resource.data.get('invoiceIssuedAt', null)
          // 2026-09: defense-in-depth, matching clause 2 — a reprint-count
          // bump (staff view-only, or the customer's own receipt re-view)
          // has no business touching the Resolve-only fields either.
          && request.resource.data.get('paymentPaidAmount', null) == resource.data.get('paymentPaidAmount', null)
          && request.resource.data.get('paymentWrittenOff', null) == resource.data.get('paymentWrittenOff', null)
        ) || (
          // 4. Driver deliver + claim (BonManzE_DeliveryPayments_Scope.md).
          // A driver marks their own assigned drop Delivered and, in the
          // same write, records a payment claim or a partial/issue note —
          // never a confirmed payment (paymentStatus is pinned below,
          // exactly like clause 2's customer self-claim). This combines a
          // status change with payment-field changes in one write, which
          // clauses 1/2 above deliberately keep separate — a dedicated
          // clause rather than a reuse, because the trust gate here is
          // different: isDriverStaff() + the item's own assignedDriverId,
          // not payments.edit. A driver's role only ever needs
          // deliveryList.edit — payments.edit (the power to actually Mark
          // Paid) is never granted to a Driver role.
          isDriverStaff()
          && resource.data.get('assignedDriverId', null) == request.auth.uid
          && canEditDeliveryList
          && resource.data.status == 'En route'
          // Client writes 'Completed' for a delivered item everywhere else
          // in this app (handleMarkDelivered/handleBulkMarkDelivered) —
          // 'Delivered' is a legacy status value some read-paths still
          // tolerate but nothing writes today, so the driver path must
          // target the same value the rest of the app actually uses.
          && request.resource.data.status == 'Completed'
          && request.resource.data.paymentStatus == resource.data.paymentStatus
          && request.resource.data.price == resource.data.price
          && request.resource.data.qty == resource.data.qty
          && request.resource.data.name == resource.data.name
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.get('entityId', null) == resource.data.get('entityId', null)
          && request.resource.data.get('assignedDriverId', null) == resource.data.get('assignedDriverId', null)
          && request.resource.data.deliveryDate == resource.data.deliveryDate
          && request.resource.data.serviceSlot == resource.data.serviceSlot
          && request.resource.data.get('invoiceNumber', null) == resource.data.get('invoiceNumber', null)
          && request.resource.data.get('invoiceIssuedAt', null) == resource.data.get('invoiceIssuedAt', null)
          && request.resource.data.get('invoiceReprintCount', null) == resource.data.get('invoiceReprintCount', null)
          // 2026-09: defense-in-depth, matching clause 2 — a driver's
          // deliver+claim write records a claim/note only, never a
          // confirmed Resolve outcome, so pin these here too.
          && request.resource.data.get('paymentPaidAmount', null) == resource.data.get('paymentPaidAmount', null)
          && request.resource.data.get('paymentWrittenOff', null) == resource.data.get('paymentWrittenOff', null)
          && (
            // Either no claim at all (the "Issue / dispute" outcome — a
            // note is required client-side, but the rule only needs to
            // stop a driver from forging a claim under someone else's
            // name), or a claim attributed to exactly this driver.
            request.resource.data.get('paymentClaimedBy', null) == null
            || (request.resource.data.get('paymentClaimedBy', null) == 'driver'
                && request.resource.data.get('paymentClaimedByStaffId', null) == request.auth.uid)
          )
        );
      }

      allow update: if isPartnerEntityAllowed(resource.data.get('entityId', null))
        && isDriverItemAllowed(resource.data.get('assignedDriverId', null))
        && canUpdateItem();
      allow delete: if false;
    }

    match /orders/{orderId}/invoiceAssignments/{dropDocId} {
      allow read, write: if false;
    }

    // Everything else stays locked down by default — same starting
    // posture as before any collection existed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
